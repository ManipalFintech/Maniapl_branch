# Both of these are meant to be public / safe to expose in browser code.
# Get them from: Supabase Dashboard -> your project -> Settings -> API

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional. Time zone used to display all times. Must match app_timezone()
# in supabase/05_bugfixes.sql. Defaults to Asia/Kolkata.
# VITE_APP_TIMEZONE=Asia/Kolkata
